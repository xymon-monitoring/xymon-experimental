Needs: #415 #919
#415 generates the systemd unit with sed on @VAR@; #919 moves every such rule to build/subst.sh and its test refuses a sed one, so the unit is generated by subst.sh here too, and #415's test accepts that form.

diff --git a/build/Makefile.rules b/build/Makefile.rules
index bab1146e5..620d8cf45 100644
--- a/build/Makefile.rules
+++ b/build/Makefile.rules
@@ -273,10 +273,7 @@ export INSTALLENVDIR
 install-systemd:
 ifneq ($(strip $(INSTALLSYSTEMDDIR)),)
 	mkdir -p $(INSTALLROOT)$(INSTALLSYSTEMDDIR)
-	sed -e 's!@XYMONHOME@!$(XYMONHOME)!g' \
-	    -e 's!@XYMONUSER@!$(XYMONUSER)!g' \
-	    -e 's!@INSTALLENVDIR@!$(INSTALLENVDIR)!g' \
-	    tools/xymonlaunch.service.DIST > $(INSTALLROOT)$(INSTALLSYSTEMDDIR)/xymonlaunch.service
+	XYMONHOME='$(XYMONHOME)' XYMONUSER='$(XYMONUSER)' INSTALLENVDIR='$(INSTALLENVDIR)' build/subst.sh XYMONHOME XYMONUSER INSTALLENVDIR <tools/xymonlaunch.service.DIST >$(INSTALLROOT)$(INSTALLSYSTEMDDIR)/xymonlaunch.service
 	chmod 644 $(INSTALLROOT)$(INSTALLSYSTEMDDIR)/xymonlaunch.service
 endif
 
diff --git a/tests/buildsystem/systemd-unit-generate.sh b/tests/buildsystem/systemd-unit-generate.sh
index 77064c5e0..ed036f443 100755
--- a/tests/buildsystem/systemd-unit-generate.sh
+++ b/tests/buildsystem/systemd-unit-generate.sh
@@ -38,7 +38,8 @@ placeholders=$(grep -oE '@[A-Z_]+@' "$dist" | sort -u)
 [ -n "$placeholders" ] || fail "tools/xymonlaunch.service.DIST carries no @PLACEHOLDER@ to substitute"
 for ph in $placeholders; do
 	name=${ph#@}; name=${name%@}
-	grep -qF "$ph!\$($name)" "$rules" \
+	# sed (s!@VAR@!$(VAR)!) or build/subst.sh (VAR='$(VAR)' ... subst.sh VAR)
+	{ grep -qF "$ph!\$($name)" "$rules" || grep -qF "$name='\$($name)'" "$rules"; } \
 		|| fail "build/Makefile.rules install-systemd does not substitute $ph with \$($name): the installed unit would keep it literal"
 done
 
